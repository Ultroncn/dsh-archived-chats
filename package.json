{
  "name": "dsh-archived-chats",
  "version": "1.6.4",
  "description": "DeepSeek Harness 的会话备份、搜索与溯源层：跨已归档会话全文搜索、ZIP 导入导出、来源与分叉只读溯源。与会话管理插件并存使用。",
  "license": "MIT",
  "author": "Ultronen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ultroncn/dsh-archived-chats.git"
  },
  "homepage": "https://github.com/Ultroncn/dsh-archived-chats",
  "bugs": {
    "url": "https://github.com/Ultroncn/dsh-archived-chats/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "backup",
    "search",
    "full-text-search",
    "lineage",
    "fork",
    "conversation-search",
    "session-lineage",
    "archive",
    "local-first",
    "sessions",
    "web-ui",
    "snapshot",
    "recycle-bin"
  ],
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "screenshots.json",
    "lib/index.js",
    "lib/about.js",
    "lib/client.js",
    "lib/trash.js",
    "lib/snapshot.js",
    "lib/export.js",
    "lib/import.js",
    "lib/metadata.js",
    "lib/durable.js",
    "lib/restore.js",
    "lib/recycle.js",
    "lib/deletion-safety.js",
    "lib/lineage.js",
    "lib/session-graph.js",
    "lib/workspace-bulk-archive.js",
    "lib/session-filters.js",
    "lib/persistence-compat.js",
    "lib/search.js",
    "lib/stats.js",
    "lib/types",
    "docs/ARCHITECTURE.md",
    "docs/ARCHITECTURE.en.md",
    "docs/USER_GUIDE.md",
    "docs/USER_GUIDE.zh-CN.md",
    "CHANGELOG.md",
    "assets/brand/archive-management-banner.png",
    "assets/screenshots",
    "cordis.patch.yml"
  ],
  "dsh": {
    "engines": {
      "dsh": ">=0.1.0-rc.7 || 0.2.2-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-session": ">=0.1.0-rc.7 <0.1.1-0 || >=0.1.1-rc.1 <0.1.2-0 || >=0.1.2-alpha.1 <0.2.0-0 || 0.1.5-rc.2 || 0.1.7-rc.2 || 0.2.0-rc.2 || 0.2.1-rc.2 || 0.2.1-rc.5 || 0.2.2-rc.1",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-session": {
      "optional": true
    }
  },
  "dependencies": {
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-session": "0.1.7-rc.2",
    "typescript": "^5.9.3"
  }
}
