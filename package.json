{
  "name": "dsh-archived-chats",
  "version": "2.0.0",
  "description": "查看、搜索和管理会话归档，支持工作区批量归档、标签备注、ZIP 备份和会话谱系。",
  "license": "MIT",
  "author": "Ultronen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ultroncn/dsh-archived-chats.git"
  },
  "homepage": "https://github.com/Ultroncn/dsh-archived-chats",
  "bugs": {
    "url": "https://github.com/Ultroncn/dsh-archived-chats/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "archive",
    "full-text-search",
    "lineage",
    "fork",
    "backup",
    "conversation-search",
    "session-lineage",
    "local-first",
    "sessions",
    "web-ui"
  ],
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "screenshots.json",
    "lib/index.js",
    "lib/deletion.js",
    "lib/deletion-tasks.js",
    "lib/about.js",
    "lib/client.js",
    "lib/export.js",
    "lib/import.js",
    "lib/metadata.js",
    "lib/durable.js",
    "lib/restore.js",
    "lib/deletion-safety.js",
    "lib/lineage.js",
    "lib/fork-provenance.js",
    "lib/session-graph.js",
    "lib/workspace-bulk-archive.js",
    "lib/session-filters.js",
    "lib/persistence-compat.js",
    "lib/search.js",
    "lib/stats.js",
    "lib/types",
    "docs/ARCHITECTURE.md",
    "docs/ARCHITECTURE.en.md",
    "docs/USER_GUIDE.md",
    "docs/USER_GUIDE.zh-CN.md",
    "CHANGELOG.md",
    "assets/brand/archive-management-banner.png",
    "assets/screenshots",
    "cordis.patch.yml"
  ],
  "dsh": {
    "engines": {
      "dsh": ">=0.2.2-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-session": ">=0.2.2-rc.1",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-session": {
      "optional": true
    }
  },
  "dependencies": {
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-session": "0.2.2-rc.1",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "zod": "4.6.7"
  }
}
